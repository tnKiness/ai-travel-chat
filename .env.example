# Leave unset to run the offline demo model (no API calls, no cost).
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium          # low | medium | high
# CHAT_MODEL=scripted           # force the offline demo model even with a key

HOST=127.0.0.1
PORT=3001
# Comma-separated list; defaults to allowing any origin in development.
# CORS_ORIGIN=http://localhost:8081

# App (Expo) — goes in app/.env, not here: where the app reaches the API (phone on your LAN).
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3001
